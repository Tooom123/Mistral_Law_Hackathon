# Optional. Without keys, CASEBREAK / BREACH runs fully offline on synthetic dossiers.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EXTRACT_MODEL=mistral-large-latest
MISTRAL_JUDGE_MODEL=mistral-large-latest
MISTRAL_FAST_MODEL=mistral-small-latest
# Leanstral is a Labs model (e.g. labs-leanstral-1-5-1): an admin must enable Labs models on the workspace
MISTRAL_LEAN_MODEL=
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# Judilibre (PISTE) API key — precedents are only ever shown when retrieved from this API
JUDILIBRE_KEY_ID=
JUDILIBRE_BASE_URL=https://api.piste.gouv.fr/cassation/judilibre/v1.0
# Freeze "today" for the deadline clock during a demo (YYYY-MM-DD)
CASEBREAK_TODAY=
# 0 disables pseudonymisation before external calls (not recommended)
CASEBREAK_PSEUDONYMIZE=1
# Models tried in order when one is refused or has no quota on the workspace (see `casebreak doctor`)
MISTRAL_FALLBACK_MODELS=mistral-medium-latest,mistral-small-latest,ministral-14b-latest,ministral-8b-latest,open-mistral-nemo
# Vision models used to transcribe scans/photos when the /ocr endpoint is unavailable
MISTRAL_VISION_MODELS=mistral-small-latest,mistral-medium-latest,ministral-14b-latest,ministral-8b-latest
# 0 disables rule-driven extraction (Mistral asked only for attributes the rules needed and did not find)
CASEBREAK_LLM_FILL=1
